{
    "name": "webrtc-data-peer",
    "version": "0.1.0",
    "description": "Small browser-native WebRTC data channel peer",
    "license": "ISC",
    "author": "",
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.json",
        "prepare": "npm run build",
        "format": "oxfmt --write .",
        "lint": "oxlint .",
        "check": "npm run lint && npm test",
        "test": "npm run build && node --test",
        "test:browser": "npm run build && node --test browser-test/index.js"
    },
    "devDependencies": {
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "playwright": "^1.64.1",
        "typescript": "^7.0.2"
    }
}
