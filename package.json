{
    "name": "webrtc-data-peer",
    "version": "0.1.0",
    "description": "Small browser-native WebRTC data channel peer",
    "license": "ISC",
    "author": "",
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsgo -p tsconfig.json",
        "prepare": "npm run build",
        "format": "oxfmt --write .",
        "lint": "oxlint .",
        "typecheck": "tsgo -p tsconfig.json --noEmit",
        "check": "npm run lint && npm run typecheck && npm test",
        "test": "npm run build && node --test"
    },
    "devDependencies": {
        "@typescript/native-preview": "^7.0.0-dev.20260525.1",
        "oxfmt": "^0.52.0",
        "oxlint": "^1.67.0",
        "typescript": "^6.0.3"
    }
}
